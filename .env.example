# Atelier configuration.
#
#   cp .env.example .env      then edit, then start
#
# Every key appears exactly once in this file, in the order you are likely to
# need it. The values below are the defaults the project ships with, so a copy
# of this file with only the secrets filled in is a working single-machine
# setup.
#
# Unset or empty keys fall back to the default in backend/atelier/config.py,
# so you may delete any line you are happy with. The four secrets in section 3
# are the exception: set them yourself before the first start.


# =============================================================================
# 1. Topology - decide this first, it governs which sections below apply
# =============================================================================
# all     one machine runs everything
#           docker compose up -d
# split   control plane on one machine, GPUs on another
#           control machine:  docker compose -f docker-compose.api.yml up -d
#           GPU node:         docker compose -f docker-compose.worker.yml up -d
# See docs/topologies.md.
#
# The compose files set ATELIER_ROLE themselves (api on the control machine,
# worker on the GPU node, all on the single-machine file), so you do not set
# it here. Set it by hand only if you run a process outside docker.
# ATELIER_ROLE=all

# GPU node only, and required there: the address of the control machine.
# ATELIER_CONTROL_HOST=192.168.1.20

# What this machine is called on the board and in the worker heartbeat.
# Defaults to "control" in the api file and "gpu-node" in the worker file.
# ATELIER_NODE_NAME=gpu-node


# =============================================================================
# 2. Where things live on the server
# =============================================================================
ATELIER_ROOT=/srv/atelier
ATELIER_EXPERIMENTS_DIR=/srv/atelier/experiments
ATELIER_MATERIALS_DIR=/srv/atelier/materials
ATELIER_DATA_DIR=/srv/atelier/data


# =============================================================================
# 3. Secrets - set every one of these before the first start
# =============================================================================
# When you split the control plane from the GPUs, these must be identical on
# both machines. Generate each with:  openssl rand -hex 32

# Signs the session cookies. Changing it signs everybody out.
ATELIER_JWT_SECRET=generate-with-openssl-rand-hex-32

# Authenticates the worker to the API. Only used when split.
ATELIER_WORKER_TOKEN=generate-with-openssl-rand-hex-32

# The Postgres and Redis passwords. Every compose file sets the Postgres
# password and builds the API's connection string from ATELIER_DB_PASSWORD.
# Only the split files use ATELIER_REDIS_PASSWORD; the single-machine file
# keeps Redis unexposed and without a password.
#
# Postgres reads its password only when it first creates the data volume.
# Changing it afterwards needs ALTER USER inside Postgres, or a fresh volume.
ATELIER_DB_PASSWORD=change-me
ATELIER_REDIS_PASSWORD=change-me


# =============================================================================
# 4. Database and queue
# =============================================================================
# The compose files build both connection URLs themselves from section 3, so
# under docker you do not set them. Set them by hand only if you run a process
# outside docker (without ATELIER_DATABASE_URL the code falls back to SQLite).
# ATELIER_DATABASE_URL=postgresql+psycopg://atelier:change-me@localhost:5432/atelier
# ATELIER_REDIS_URL=redis://localhost:6379/0

# Where the control machine publishes Postgres and Redis for the GPU node to
# reach. Only read by the split files.
# ATELIER_DB_PORT=5432
# ATELIER_REDIS_PORT=6379


# =============================================================================
# 5. Accounts
# =============================================================================
# Used only to create the first teacher on an empty database. Changing them
# later does nothing; change the password in the UI instead.
ATELIER_ADMIN_USERNAME=teacher
ATELIER_ADMIN_PASSWORD=teacher
ATELIER_JWT_EXPIRE_HOURS=12


# =============================================================================
# 6. GPUs and scheduling
# =============================================================================
# There is no GPU count to set: each worker asks the NVIDIA driver how many GPUs
# it can see, reports that in its heartbeat, and the API adds the workers up.
# Set this only to override the detected number, for example to hold GPUs back
# from student jobs, or 0 to run without GPUs.
# ATELIER_GPU_COUNT=

# A worker with no GPUs runs jobs on CPU, this many at a time (default 1). A run
# that asks for GPUs goes to a GPU node when one is up and runs on CPU only when
# none is. Start such a node with docker-compose.worker-cpu.yml layered on top.
# ATELIER_CPU_SLOTS=1

ATELIER_MAX_RUNNING_PER_STUDENT=2
ATELIER_MAX_GPUS_PER_STUDENT_RUN=2
ATELIER_DEFAULT_TIMEOUT_MIN=360


# =============================================================================
# 7. How a run is executed
# =============================================================================
# subprocess  fast, shares the worker image
# docker      one container per run
ATELIER_RUNNER_BACKEND=subprocess
ATELIER_RUNNER_IMAGE=atelier-worker:latest
ATELIER_RUNNER_MEMORY=64g


# =============================================================================
# 8. Wall displays
# =============================================================================
ATELIER_DISPLAY_COUNT=5
# true: /display/N needs no login (the screens are in your room, on your LAN)
ATELIER_DISPLAYS_PUBLIC=true
ATELIER_BOARD_INTERVAL_SEC=5
ATELIER_GRAFANA_URL=/grafana/d/atelier-hw/hardware?orgId=1&kiosk&refresh=5s
# The Grafana admin password. Reachable only from your LAN.
# ATELIER_GRAFANA_PASSWORD=atelier


# =============================================================================
# 9. Limits and ports
# =============================================================================
ATELIER_SUBMISSION_MAX_MB=2048
ATELIER_WORKSPACE_MAX_MB=4096
ATELIER_HTTP_PORT=80


# =============================================================================
# 10. Storage between the two machines
# =============================================================================
# shared  both machines see the same data directory (one machine, or a mount)
# upload  they do not; the worker posts results back over HTTP. This is the
#         default for the split files and needs no shared filesystem at all.
# The code's own fallback is "shared", so leave this set for a split run.
ATELIER_STORAGE_MODE=upload

# Artifacts bigger than this stay on the GPU node rather than crossing the LAN.
# Checkpoints are usually over it; charts, tables and JSONL samples are not.
ATELIER_UPLOAD_MAX_MB=64

# Shared storage over NFS, only when ATELIER_STORAGE_MODE=shared. Layer
# docker-compose.nfs.yml on top of the api or worker file and docker mounts the
# export itself.
# ATELIER_NFS_HOST=192.168.1.30
# ATELIER_NFS_DATA=/export/atelier/data
# ATELIER_NFS_EXPERIMENTS=/export/atelier/experiments

# Where the deploy scripts copy materials from before a worker starts, as
# server:/export/path. Copied, not mounted: each node keeps its own copy under
# /srv/atelier/materials and reads it at local-disk speed. See docs/deploy-workers.md.
# ATELIER_MATERIALS_NFS=192.168.1.50:/export/atelier/materials


# =============================================================================
# 11. Runtime: CUDA, PyTorch and Python
# =============================================================================
# These four have to agree. See docs/runtime.md for the combinations that work.
#
#   Ampere and newer only (A6000, A100, L40S, H100, RTX 40/50):
#     cu128 + nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
#   Also covers Maxwell, Pascal and Volta (GTX 10-series, V100, Titan V):
#     cu126 + nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
#   Newest, drops Maxwell/Pascal/Volta entirely:
#     cu130 + nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04
#   Worker nodes without GPUs set nothing here: docker-compose.worker-cpu.yml
#   builds atelier-worker-cpu with cpu + ubuntu:24.04 itself.
ATELIER_CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ATELIER_CUDA_WHEEL=cu128
ATELIER_CUDA_MM=12.8
ATELIER_TORCH_VERSION=2.8.0
ATELIER_PYTHON_VERSION=3.12


# =============================================================================
# 12. Images
# =============================================================================
# A registry prefix for an air-gapped install, ending in a slash, for example
# harbor.local/atelier/ . Empty means Docker Hub and a local build.
# See docs/harbor.md.
# ATELIER_REGISTRY=
# ATELIER_TAG=latest


# =============================================================================
# 13. Rarely changed
# =============================================================================
# The worker's metrics listener, scraped by Prometheus on the control machine.
# 0 turns it off. Add the node to deploy/prometheus/targets/gpu-nodes.yml too.
ATELIER_WORKER_METRICS_PORT=9101

# Browser origins allowed to call the API. Only needed when you run the Vite
# dev server against a non-local API.
# ATELIER_CORS_ORIGINS=http://localhost:5173

# How many lines the log view tails.
# ATELIER_LOG_TAIL_LINES=400

# The interpreter the runner invokes for a student's code.
# ATELIER_PYTHON=python

# How often the worker flushes artifacts back to the API, in seconds.
# ATELIER_UPLOAD_INTERVAL_SEC=3.0

# How long a worker's GPU snapshot stays fresh in Redis, in seconds.
# ATELIER_GPU_SNAPSHOT_TTL_SEC=15

# Set by the worker compose file; only set it by hand if you run the worker
# outside docker.
# ATELIER_API_URL=http://localhost:8000
